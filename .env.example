DATABASE_URL="postgresql://postgres:password@localhost:5432/transpo24?schema=public"

ACCESS_TOKEN_SECRET="replace_with_a_long_random_secret"
CORS_ORIGINS="http://localhost:3000,http://localhost:8081"
# Set true only when the API runs behind one trusted reverse proxy.
TRUST_PROXY="false"
# Destructive reset routes are disabled unless explicitly enabled outside production.
ENABLE_TEST_ENDPOINTS="false"
JSON_BODY_LIMIT="1mb"

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Optional reusable credentials for Google Play review. Configure both values,
# keep them backend-only, and rotate/remove them after approval.
PLAY_REVIEW_PHONE_NUMBER=
PLAY_REVIEW_OTP_CODE=

REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD=""

STRIPE_SECRET_KEY="replace_with_your_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="replace_with_your_stripe_webhook_secret"
# Optional explicit selection; see .env.stripe-production.example.
# STRIPE_MODE=test
# STRIPE_TEST_SECRET_KEY=sk_test_...
# STRIPE_TEST_WEBHOOK_SECRET=whsec_...
# STRIPE_LIVE_SECRET_KEY=sk_live_...
# STRIPE_LIVE_WEBHOOK_SECRET=whsec_...
STRIPE_CURRENCY="CHF"

# Enable only after deploying the additive migration, compatible apps, and completing
# docs/payment-rules-verification.md. Existing delayed bookings keep processing when off.
DELAYED_BOOKING_AUTHORIZATION_ENABLED="false"

GOOGLE_MAPS_API_KEY="replace_with_your_google_maps_api_key"
PORT=3001

# Backend-only registration extraction. Select the base URL for your key's region/workspace.
# https://www.alibabacloud.com/help/en/model-studio/qwen-api-via-openai-chat-completions
QWEN_API_KEY=
QWEN_BASE_URL=
QWEN_MODEL=qwen3.7-plus

# Backend-only VIN provider credentials. Never expose these to either mobile app.
SWISSCARINFO_API_KEY="replace_with_your_swisscarinfo_key"
SWISSCARINFO_API_URL="https://api.swisscarinfo.ch/v3/search"
SWISSCARINFO_TIMEOUT_MS=10000
ONEAUTOAPI_API_KEY="replace_with_your_oneautoapi_key"
ONEAUTOAPI_API_URL="https://api.oneautoapi.com/oneauto/vindecodebasic/us/v2"
ONEAUTOAPI_TIMEOUT_MS=10000
DRIVER_APP_BASE_URL="https://example.com"

WEB_PUSH_VAPID_PUBLIC_KEY=""
WEB_PUSH_VAPID_PRIVATE_KEY=""
WEB_PUSH_VAPID_SUBJECT="mailto:admin@transpo24.com"

# Google Cloud Translation. Never commit a service-account file or real key.
GOOGLE_APPLICATION_CREDENTIALS=""
GOOGLE_TRANSLATE_PROJECT_ID="replace_with_your_project_id"
GOOGLE_TRANSLATE_CLIENT_EMAIL="replace_with_your_service_account_email"
GOOGLE_TRANSLATE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace_with_your_private_key\n-----END PRIVATE KEY-----\n"
GOOGLE_TRANSLATE_CREDENTIALS_JSON=""
TRANSLATION_CACHE_TTL_SECONDS=86400
TRANSLATION_RATE_LIMIT_WINDOW_SECONDS=60
TRANSLATION_RATE_LIMIT_MAX_REQUESTS=30

# Mobile push isolation; use PRODUCTION only on the production backend.
PUSH_ENVIRONMENT=DEVELOPMENT

# Enable after migrations and compatible customer/driver apps are deployed.
# Requires REDIS_HOST and an operational reservation worker.
FURNITURE_RESERVATIONS_ENABLED=false

# One backend key per environment: allow Routes API, Places API (New), and
# Geocoding API; restrict to that environment's outbound IP. Never EXPO_PUBLIC_.
GOOGLE_MAPS_SERVER_API_KEY=
# Legacy variable names remain supported during deployment; no extra keys needed.
GOOGLE_ROUTES_API_KEY=
GOOGLE_PLACES_API_KEY=
