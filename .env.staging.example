# Separate infrastructure only. Never point staging at the production database.
NODE_ENV="staging"
DATABASE_URL="postgresql://<user>:<password>@<staging-db-host>:5432/transpo24_staging?schema=public"
ACCESS_TOKEN_SECRET="replace_with_a_unique_32_plus_character_staging_secret"
CORS_ORIGINS="https://api-staging.example.com"
TRUST_PROXY="true"
ENABLE_TEST_ENDPOINTS="false"

TWILIO_ACCOUNT_SID="replace_with_staging_or_test_credentials"
TWILIO_AUTH_TOKEN="replace_with_staging_or_test_credentials"
TWILIO_VERIFY_SERVICE_SID="replace_with_a_staging_verify_service"

REDIS_HOST="<staging-redis-host>"
REDIS_PORT="6379"
REDIS_PASSWORD=""

# Obtain both values from Stripe's test sandbox. They must never be committed.
STRIPE_SECRET_KEY="sk_test_replace_with_your_stripe_test_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_replace_with_the_staging_webhook_secret"
STRIPE_CURRENCY="CHF"

DRIVER_APP_BASE_URL="https://driver-staging.example.com"
PORT="3001"
