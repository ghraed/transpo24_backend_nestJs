# Stripe-only overlay; merge into the production server's environment.
# NODE_ENV stays production. No changes to database, auth, CORS, or app URLs.
# Copy to .env.stripe-production.local; never commit the populated file.
# Use keys from the SAME Stripe account/sandbox as the client's publishable key.
STRIPE_MODE=test
STRIPE_TEST_SECRET_KEY=
# Signing secret for the DEPLOYED test webhook, not stripe listen's local secret.
STRIPE_TEST_WEBHOOK_SECRET=
STRIPE_LIVE_SECRET_KEY=
STRIPE_LIVE_WEBHOOK_SECRET=
