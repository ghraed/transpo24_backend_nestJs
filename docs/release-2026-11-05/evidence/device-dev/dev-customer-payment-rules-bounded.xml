<hierarchy rotation="0"><node index="0" text="" resource-id="" class="android.widget.FrameLayout" package="com.transpo24.app.dev" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][1080,2400]"><node index="0" text="" resource-id="" class="android.widget.ScrollView" package="com.transpo24.app.dev" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="true" focused="false" scrollable="true" long-clickable="false" password="false" selected="false" bounds="[44,84][1036,2356]"><node index="11" text="Before a card hold expires, we attempt a replacement hold. Holds may temporarily overlap. If renewal fails, cancellation is free before pickup; after pickup the case requires manual review." resource-id="" class="android.widget.TextView" package="com.transpo24.app.dev" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[110,84][970,362]" /><node index="12" text="Cancellation fees are timed from the start of the countdown. Cancellation before job assignment is free." resource-id="" class="android.widget.TextView" package="com.transpo24.app.dev" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[110,422][970,620]" /><node index="13" text="From 10 minutes: 15% cancellation fee, until the next tier." resource-id="" class="android.widget.TextView" package="com.transpo24.app.dev" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[110,681][970,813