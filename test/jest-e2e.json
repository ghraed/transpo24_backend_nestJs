{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^expo-server-sdk$": "<rootDir>/../src/test-support/expo-server-sdk.mock.ts"
  },
  "testTimeout": 15000
}
